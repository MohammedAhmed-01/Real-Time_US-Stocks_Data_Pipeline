# ──────────────────────────────────────────────────────────────────────────────
#  .env.example — copy to .env and fill in your own values:
#      cp env.example .env
#
#  This is the SINGLE .env file for `docker compose up` at the repo root.
#  It covers every credential/setting used across all services
#  (M1 Kafka, M2 Spark Streaming, M3 SparkSQL/Postgres, MinIO, pgAdmin).
#
#  Never commit the real .env to Git — it's already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Kaggle credentials (REQUIRED — no default, producer will fail without these) ─
# Find these at https://www.kaggle.com/settings → API → Create New Token
# ⚠️ Rotate immediately if you ever paste a real key into this file and commit it.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Kafka ─────────────────────────────────────────────────────────────────────
# From your host machine, brokers are reachable at localhost:9092 / 9093 / 9094
# From inside the Docker network (e.g. Airflow), use:
#   kafka-1:29092,kafka-2:29093,kafka-3:29094
KAFKA_BOOTSTRAP=localhost:9092,localhost:9093,localhost:9094

# Topic names (must match what the kafka-init service creates)
KAFKA_TOPIC=us-stocks-raw
KAFKA_DLT_TOPIC=us-stocks-dead-letter

# Consumer group used by the M1 validation consumer.
# M2 (Spark Structured Streaming) uses a separate group: spark-streaming-group
KAFKA_GROUP_ID=m1-validation-group

# ── MinIO (S3-compatible object store — replaces HDFS) ───────────────────────
# MinIO API     : http://localhost:9000  (used by Spark's S3A connector)
# MinIO Console : http://localhost:9001  (browser UI)
#
# Defaults below match docker-compose.yml's fallback values, so the stack
# works out of the box on localhost. Change them before deploying anywhere
# that isn't your own machine.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Bucket where all Parquet data and Spark checkpoints are stored
MINIO_BUCKET=stocks

# ── PostgreSQL (M3 analytics output store) ───────────────────────────────────
# Reachable at localhost:5432 from your host, or postgres:5432 inside Docker.
POSTGRES_DB=stocks_analytics
POSTGRES_USER=stocks
POSTGRES_PASSWORD=stocks123

# ── pgAdmin (web UI for Postgres, http://localhost:5050) ─────────────────────
PGADMIN_DEFAULT_EMAIL=admin@stocks.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ── Airflow (orchestration UI, http://localhost:8082) ────────────────────────
# AIRFLOW_SECRET_KEY signs webserver sessions/cookies — generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=please-change-me-in-.env
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Airflow's own metadata DB (postgres-airflow service) is separate from the
# analytics Postgres above and is NOT parametrized here on purpose — it never
# holds business data, so its fixed airflow/airflow credentials are fine
# for local/dev use.
