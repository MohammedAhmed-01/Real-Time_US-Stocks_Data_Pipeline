# ──────────────────────────────────────────────────────────────────────────────
#  .env.example — copy to .env and fill in your values
#  Never commit the real .env to Git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Kaggle credentials ────────────────────────────────────────────────────────
# Find these at https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Kafka ─────────────────────────────────────────────────────────────────────
# From your machine, brokers are on localhost:9092 / 9093 / 9094
# Inside Docker network, use:  kafka-1:29092,kafka-2:29093,kafka-3:29094
KAFKA_BOOTSTRAP=localhost:9092,localhost:9093,localhost:9094

# Topic names (must match what kafka-init creates)
KAFKA_TOPIC=us-stocks-raw
KAFKA_DLT_TOPIC=us-stocks-dead-letter

# Consumer group used by the M1 validation consumer
# M2 (Spark) will use a different group: spark-streaming-group
KAFKA_GROUP_ID=m1-validation-group

# ── MinIO (S3-compatible object store — replaces HDFS) ───────────────────────
# MinIO API  : http://localhost:9000  (used by Spark S3A connector)
# MinIO UI   : http://localhost:9001  (browser console)
#
# Change these values before deploying to any environment that isn't localhost.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Bucket where all Parquet data and checkpoints are stored
MINIO_BUCKET=stocks
